rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Authentication and Identity Helpers
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isSuperAdmin() {
      return hasRole('SUPERADMIN');
    }

    function isAdmin() {
      return hasRole('ADMIN') || isSuperAdmin();
    }

    function isDentist() {
      return hasRole('DENTIST');
    }

    function isLabTech() {
      return hasRole('LAB_TECH');
    }

    function isPatient() {
      return hasRole('PATIENT');
    }

    // =========================================================================
    // USERS COLLECTION: Server-Authoritative Role Provisioning
    // - Self-registration (Email or Google) can ONLY create a PATIENT role.
    // - Users CANNOT modify or escalate their own role.
    // - Only ADMIN or SUPERADMIN can update roles or provision staff.
    // =========================================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      // On creation: User can only create their own profile as PATIENT, or Admin/SuperAdmin can provision staff
      allow create: if (isOwner(userId) && request.resource.data.role == 'PATIENT') || isAdmin();
      
      // On update: Self-update allowed only if role is NOT modified; Admins can modify any field including role
      allow update: if (
        isOwner(userId) && request.resource.data.role == resource.data.role
      ) || isAdmin();
      
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // APPOINTMENTS COLLECTION
    // =========================================================================
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid ||
        isDentist() ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.dentistId == request.auth.uid ||
        isDentist() ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // ODONTOGRAMS COLLECTION (Patient 32-Tooth Chart)
    // =========================================================================
    match /odontograms/{patientId} {
      allow read: if isAuthenticated() && (
        patientId == request.auth.uid ||
        isDentist() ||
        isAdmin()
      );
      allow write: if isDentist() || isAdmin();
    }

    // =========================================================================
    // TREATMENT PLANS COLLECTION
    // =========================================================================
    match /treatmentPlans/{treatmentId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        isDentist() ||
        isAdmin()
      );
      allow write: if isDentist() || isAdmin();
    }

    // =========================================================================
    // DENTAL IMAGES COLLECTION (Cloudinary Metadata Store)
    // =========================================================================
    match /dentalImages/{imageId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        isDentist() ||
        isLabTech() ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        isDentist() ||
        isAdmin()
      );
      allow update: if isDentist() || isAdmin();
      allow delete: if isDentist() || isAdmin();
    }

    // =========================================================================
    // LAB ORDERS COLLECTION (Service-Specific Laboratory Workflow & RBAC)
    // - Patients have ZERO read/write access (protects internal notes & Rx data).
    // - Partner lab accounts with `assignedVendor` are scoped to their vendor.
    // - Only Clinic Dentists / Admins can create requests or mark COMPLETED.
    // - Laboratory personnel manage intake, production, QC, and dispatch.
    // =========================================================================
    function isAuthorizedLabForOrder(orderData) {
      return isLabTech() && (
        !('assignedVendor' in getUserData()) ||
        getUserData().assignedVendor == '' ||
        orderData.vendor == getUserData().assignedVendor
      );
    }

    match /labOrders/{orderId} {
      allow read: if isAdmin() || isDentist() || isAuthorizedLabForOrder(resource.data);

      allow create: if (isAdmin() || isDentist()) &&
        request.resource.data.status == 'PENDING_REVIEW' &&
        request.resource.data.applianceType is string;

      allow update: if (
        request.resource.data.get('patientId', '') == resource.data.get('patientId', '')
      ) && (
        isAdmin() ||
        (
          isDentist() && (
            request.resource.data.status == resource.data.status ||
            (request.resource.data.status == 'COMPLETED' && resource.data.status in ['READY_FOR_DISPATCH', 'DISPATCHED', 'READY']) ||
            (request.resource.data.status == 'ISSUE_REPORTED' && resource.data.status in ['READY_FOR_DISPATCH', 'DISPATCHED', 'READY']) ||
            (request.resource.data.status == 'PENDING_REVIEW' && resource.data.status in ['CLARIFICATION_REQUESTED', 'REVISION_NEEDED'])
          )
        ) ||
        (
          isAuthorizedLabForOrder(resource.data) &&
          request.resource.data.status != 'COMPLETED'
        )
      );

      allow delete: if isAdmin();

      // Internal Laboratory Bench Notes — strictly hidden from Patients and Clinic Dentists
      match /internalNotes/{noteId} {
        allow read: if isAdmin() || isLabTech();
        allow create: if (isAdmin() || isLabTech()) && (
          request.resource.data.get('note', '') is string ||
          request.resource.data.get('message', '') is string
        );
        allow update, delete: if isAdmin();
      }
    }

    // =========================================================================
    // LAB WORKFLOW TEMPLATES COLLECTION (Workflow E Configurable Templates)
    // =========================================================================
    match /labWorkflows/{workflowId} {
      allow read: if isAdmin() || isDentist() || isLabTech();
      allow create, update: if (isAdmin() || isLabTech()) &&
        request.resource.data.stages is list;
      allow delete: if isAdmin();
    }

    // =========================================================================
    // NOTIFICATIONS COLLECTION
    // =========================================================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // =========================================================================
    // BRUSHING STREAKS COLLECTION
    // =========================================================================
    match /brushStreaks/{patientId} {
      allow read: if isAuthenticated() && (
        patientId == request.auth.uid ||
        isDentist() ||
        isAdmin()
      );
      allow write: if isAuthenticated() && patientId == request.auth.uid;
    }

    // =========================================================================
    // AUDIT LOGS COLLECTION (Immutable Append-Only Audit Trail)
    // =========================================================================
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // =========================================================================
    // CHAT SESSIONS COLLECTION (SmileGuard Assistant History)
    // =========================================================================
    match /chatSessions/{sessionId} {
      allow read, write: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid
      );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}

