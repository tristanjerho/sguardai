# SmileGuard AI - Environment Configuration Example
# Client-Safe Public Variables (bundled into frontend)

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Cloudinary Configuration (Unsigned Client Upload Preset)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# AI Diagnostic Service (Real Trained CNN Backend)
VITE_AI_SERVICE_URL=http://127.0.0.1:8000/api/predict
VITE_AI_MODEL_INFO_URL=http://127.0.0.1:8000/api/model-info
